enum 50600 "PIM Attribute Type"
{
    Extensible = true;

    value(0; Text)
    {
        Caption = 'Text';
    }
    value(1; Decimal)
    {
        Caption = 'Number';
    }
    value(2; Boolean)
    {
        Caption = 'Yes/No';
    }
    value(3; Option)
    {
        Caption = 'Option';
    }
    value(4; Date)
    {
        Caption = 'Date';
    }
}
